# ==========================================
# FARMIAX FRONTEND ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Backend REST API Base URL
VITE_API_BASE_URL=https://farmiax-web-backend.onrender.com/api/v1

# 2. Google OAuth Client ID (For Google One-Tap & Social Login)
VITE_GOOGLE_CLIENT_ID=your_production_google_oauth_client_id.apps.googleusercontent.com

# 3. Razorpay Key ID (For Online Payments)
VITE_RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id

# 4. Stripe Publishable Key (For Card Payments)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
